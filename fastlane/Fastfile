require "fileutils"

default_platform(:tvos)

platform :tvos do
  desc "Description of what the lane does"
  lane :build_simulator do
    build_app(
      skip_package_ipa: true,
      skip_archive: true,
      destination: "platform=tvOS Simulator,name=Apple TV"
    )
  end

  lane :build_unsign_ipa do
    repo_root = File.expand_path("..", __dir__)
    archive_path = File.join(repo_root, "App.xcarchive")
    payload_path = File.join(repo_root, "Payload")
    ipa_path = File.join(repo_root, "BilbiliAtvDemo.ipa")
    top_products = File.join(repo_root, ".topshelf-products")
    top_intermediates = File.join(repo_root, ".topshelf-intermediates")

    sh("rm", "-rf", payload_path, archive_path, ipa_path, top_products, top_intermediates)

    build_app(
      destination: "generic/platform=tvOS",
      configuration: "Release",
      codesigning_identity: "",
      skip_codesigning: true,
      skip_package_ipa: true,
      archive_path: archive_path,
    )

    sh(
      "xcodebuild", "build",
      "-project", File.join(repo_root, "BilibiliTopShelf/BilibiliTopShelf.xcodeproj"),
      "-target", "BilibiliTopShelf",
      "-configuration", "Release",
      "-sdk", "appletvos",
      "-destination", "generic/platform=tvOS",
      "SYMROOT=#{top_products}",
      "OBJROOT=#{top_intermediates}",
      "CODE_SIGNING_ALLOWED=NO",
      "CODE_SIGNING_REQUIRED=NO",
      "CODE_SIGN_IDENTITY=",
      "DEVELOPMENT_TEAM="
    )

    appex_path = File.join(top_products, "Release-appletvos/BilibiliTopShelf.appex")
    UI.user_error!("Top Shelf extension was not produced: #{appex_path}") unless File.directory?(appex_path)

    applications_path = File.join(archive_path, "Products/Applications")
    UI.user_error!("Archived Applications directory missing: #{applications_path}") unless File.directory?(applications_path)
    FileUtils.mv(applications_path, payload_path)

    app_path = Dir[File.join(payload_path, "*.app")].first
    UI.user_error!("Main tvOS .app was not found in Payload") unless app_path

    plugins_path = File.join(app_path, "PlugIns")
    FileUtils.mkdir_p(plugins_path)
    embedded_appex = File.join(plugins_path, "BilibiliTopShelf.appex")
    sh("ditto", appex_path, embedded_appex)

    ext_info = File.join(embedded_appex, "Info.plist")
    plist_buddy = "/usr/libexec/PlistBuddy"
    ext_platform = sh(plist_buddy, "-c", "Print :CFBundleSupportedPlatforms:0", ext_info, log: false).strip
    ext_dt_platform = sh(plist_buddy, "-c", "Print :DTPlatformName", ext_info, log: false).strip
    ext_family = sh(plist_buddy, "-c", "Print :UIDeviceFamily:0", ext_info, log: false).strip
    ext_point = sh(plist_buddy, "-c", "Print :NSExtension:NSExtensionPointIdentifier", ext_info, log: false).strip

    UI.message("Top Shelf CFBundleSupportedPlatforms=#{ext_platform}")
    UI.message("Top Shelf DTPlatformName=#{ext_dt_platform}")
    UI.message("Top Shelf UIDeviceFamily=#{ext_family}")
    UI.message("Top Shelf NSExtensionPointIdentifier=#{ext_point}")

    UI.user_error!("Top Shelf is not AppleTVOS") unless ext_platform == "AppleTVOS"
    UI.user_error!("Top Shelf was not built with appletvos SDK") unless ext_dt_platform == "appletvos"
    UI.user_error!("Top Shelf target device family is not Apple TV") unless ext_family == "3"
    UI.user_error!("Unexpected Top Shelf extension point") unless ext_point == "com.apple.tv-top-shelf"

    sh("file", File.join(embedded_appex, "BilibiliTopShelf"))
    Dir.chdir(repo_root) do
      sh("/usr/bin/zip", "-qry", "BilbiliAtvDemo.ipa", "Payload")
    end
    UI.user_error!("IPA was not produced: #{ipa_path}") unless File.file?(ipa_path)

    sh("ls", "-lh", ipa_path)
    sh("rm", "-rf", payload_path, archive_path, top_products, top_intermediates)
  end
end
